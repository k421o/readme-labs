{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/readmes/artifact-record-v1.schema.json",
  "title": "README Labs artifact record v1",
  "description": "Identity, custody, provenance, occurrence, and collection metadata for one captured README artifact. Capture freezes the recorded bytes; it does not constrain a working README before capture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "artifact",
    "capture",
    "custody",
    "provenance",
    "occurrences",
    "memberships",
    "lineage",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"$ref": "#/$defs/record_id"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_sha256",
        "media_type",
        "byte_length",
        "original_name",
        "storage"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/artifact_id"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"const": "text/markdown"},
        "byte_length": {"type": ["integer", "null"], "minimum": 0},
        "original_name": {"type": "string", "minLength": 1},
        "storage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "path", "sha256"],
              "properties": {
                "mode": {"const": "embedded"},
                "path": {"const": "artifact.md"},
                "sha256": {"$ref": "#/$defs/digest"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "reference_path",
                "reference_sha256",
                "locator"
              ],
              "properties": {
                "mode": {"const": "external_reference"},
                "reference_path": {"const": "artifact.ref.json"},
                "reference_sha256": {"$ref": "#/$defs/digest"},
                "locator": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "boundary",
        "captured_at",
        "pre_capture_editability"
      ],
      "properties": {
        "state": {"const": "captured"},
        "boundary": {
          "enum": [
            "completed_generation",
            "observed_source_snapshot",
            "ingestion_selection",
            "explicit_manual_capture"
          ]
        },
        "captured_at": {"type": "string", "format": "date-time"},
        "pre_capture_editability": {
          "enum": ["mutable", "not_applicable", "unknown"]
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "visibility", "body_policy"],
      "properties": {
        "ownership": {"enum": ["owned", "third_party", "unknown"]},
        "visibility": {
          "enum": ["public", "private", "local_only", "unknown"]
        },
        "body_policy": {"enum": ["embedded", "reference_only"]},
        "license_spdx": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "occurrences": {
      "type": "array",
      "items": {"$ref": "#/$defs/occurrence"}
    },
    "memberships": {
      "type": "array",
      "items": {"$ref": "#/$defs/membership"}
    },
    "lineage": {
      "type": "array",
      "items": {"$ref": "#/$defs/lineage"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_id": {"type": "string", "pattern": "^rm-[0-9a-f]{16}$"},
    "event_id": {
      "type": "string",
      "pattern": "^(?:prov|occ)-[0-9a-f]{16}$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["skill", "candidate", "workflow", "human", "other"]
        },
        "id": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "recorded_at", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/event_id"},
        "kind": {
          "enum": ["generated", "retrieved", "ingested", "authored", "synthetic"]
        },
        "recorded_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/$defs/source"},
        "producer": {"$ref": "#/$defs/producer"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [{"required": ["source"]}, {"required": ["producer"]}]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "revision",
        "path",
        "role",
        "content_sha256"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/event_id"},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "tree": {"type": ["string", "null"]},
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "retrieval_url": {"type": "string", "format": "uri"}
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "purpose", "recorded_at"],
      "properties": {
        "collection_id": {"$ref": "#/$defs/domain_id"},
        "purpose": {
          "enum": [
            "reference_sample",
            "generated_output",
            "candidate_output",
            "fixture",
            "regression_baseline",
            "accepted_example",
            "personal_corpus",
            "experiment_subject"
          ]
        },
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship"],
      "properties": {
        "relationship": {
          "enum": ["derived_from", "variant_of", "supersedes", "reproduces"]
        },
        "target_record_id": {"$ref": "#/$defs/record_id"},
        "target_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "note": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["target_record_id"]},
        {"required": ["target_artifact_id"]}
      ]
    }
  }
}
