{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/experiments/schemas/evaluator-v1.schema.json",
  "title": "README Labs soft evaluator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "authority",
    "perspective",
    "instructions",
    "response_schema",
    "recommendations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"const": "soft_agent_review"},
    "authority": {"const": "advisory"},
    "perspective": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1},
    "response_schema": {"type": "string", "minLength": 1},
    "recommendations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
