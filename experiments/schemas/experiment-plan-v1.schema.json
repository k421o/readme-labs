{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/experiments/schemas/experiment-plan-v1.schema.json",
  "title": "README Labs experiment plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "question",
    "candidate_ids",
    "method",
    "planned_trials",
    "completion_policy",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "method": {
      "type": "object",
      "required": ["id", "version", "parameters"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      },
      "additionalProperties": true
    },
    "planned_trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "candidate_ids", "measurements"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "running", "completed", "incomplete"]},
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"}
          },
          "measurements": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "run_records": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automated_results_authority",
        "candidate_admission_gate",
        "allowed_early_stops",
        "early_stop_disposition"
      ],
      "properties": {
        "mode": {"const": "complete_planned_run"},
        "automated_results_authority": {"const": "evidence_only"},
        "candidate_admission_gate": {"const": "none"},
        "allowed_early_stops": {
          "type": "array",
          "items": {"enum": ["safety", "authorization", "infrastructure"]},
          "uniqueItems": true
        },
        "early_stop_disposition": {"const": "incomplete_not_rejected"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "timing", "allowed_outcomes"],
      "properties": {
        "authority": {"const": "owner_or_designated_review"},
        "timing": {"const": "after_planned_trials_complete"},
        "allowed_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["iterate", "combine", "retain", "reject", "promote"]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
