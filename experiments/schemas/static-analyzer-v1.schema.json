{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/experiments/schemas/static-analyzer-v1.schema.json",
  "title": "README Labs static analyzer adapter v1",
  "description": "A versioned adapter definition for evidence-producing README static analysis. It does not define a native contract for every underlying tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "authority",
    "adapter",
    "documentation",
    "supported_modes",
    "rules",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"const": "static_analyzer"},
    "authority": {"const": "evidence_only"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation",
        "version",
        "native_output"
      ],
      "properties": {
        "kind": {"enum": ["builtin_python", "external_command"]},
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "native_output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preserved", "contract"],
          "properties": {
            "preserved": {"type": "boolean"},
            "contract": {"type": ["string", "null"]}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "external_command"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "native_output": {
                "properties": {
                  "preserved": {"const": true},
                  "contract": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "documentation": {"type": "string", "minLength": 1},
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["document_diagnostic", "corpus_characterization"]}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "default_level",
          "requires_context",
          "interpretation"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "default_level": {"enum": ["note", "warning", "error"]},
          "requires_context": {"enum": ["document", "repository", "network"]},
          "interpretation": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
