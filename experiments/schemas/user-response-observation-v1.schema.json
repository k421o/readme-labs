{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/experiments/schemas/user-response-observation-v1.schema.json",
  "title": "README Labs user-response observation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "artifact_id",
    "observed_at",
    "method",
    "participant_scope",
    "privacy",
    "payload",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "method": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "participant_scope": {
      "type": "object",
      "required": ["kind", "count"],
      "properties": {
        "kind": {"enum": ["individual", "cohort", "aggregate"]},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "direct_identifiers_committed", "consent_basis"],
      "properties": {
        "classification": {"enum": ["public", "pseudonymous", "aggregate"]},
        "direct_identifiers_committed": {"const": false},
        "consent_basis": {"type": ["string", "null"]},
        "protected_raw_data_reference": {"type": ["string", "null"]}
      }
    },
    "payload": {
      "description": "Method-defined observations. The envelope intentionally does not prescribe one research method.",
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
