{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/intake/source-manifest-v1.schema.json",
  "title": "README Labs source intake manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "observed_at",
    "source_repository",
    "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "availability"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "default_branch": {"type": ["string", "null"]},
        "availability": {
          "enum": ["remote", "local_only", "embedded", "external"]
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "relationship", "to"],
        "properties": {
          "from": {"$ref": "#/$defs/id"},
          "relationship": {"type": "string", "minLength": 1},
          "to": {"$ref": "#/$defs/id"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "revision",
            "path",
            "artifact_type",
            "git_oid",
            "sha256"
          ],
          "properties": {
            "state": {"const": "committed"},
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {"type": "string", "minLength": 1},
            "artifact_type": {"enum": ["file", "tree"]},
            "git_oid": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "sha256": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "observed_at",
            "path",
            "artifact_type",
            "sha256"
          ],
          "properties": {
            "state": {"const": "workspace"},
            "observed_at": {"type": "string", "format": "date-time"},
            "path": {"type": "string", "minLength": 1},
            "artifact_type": {"enum": ["file", "tree"]},
            "sha256": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "locator", "sha256"],
          "properties": {
            "state": {"const": "external"},
            "locator": {"type": "string", "minLength": 1},
            "revision": {"type": ["string", "null"]},
            "sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_type", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "artifact_type": {"enum": ["file", "tree"]},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "intake_mode",
        "status",
        "authority",
        "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "readme_artifact",
            "repository",
            "research_content",
            "research_method",
            "evaluation_method",
            "skill",
            "skill_bundle",
            "plugin",
            "tooling",
            "automation",
            "script",
            "trial_evidence",
            "agent_response",
            "user_response",
            "dataset",
            "other"
          ]
        },
        "source": {"$ref": "#/$defs/source"},
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "intake_mode": {"enum": ["reference", "snapshot", "derived"]},
        "status": {"enum": ["admitted", "quarantined", "excluded"]},
        "authority": {"const": "evidence_only"},
        "description": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
