{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/intake/ingestion-job-v1.schema.json",
  "title": "README Labs managed ingestion job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "created_at",
    "updated_at",
    "source",
    "acquisition",
    "inventory",
    "selections",
    "admission",
    "verification",
    "finalization",
    "action_log"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "status": {
      "enum": [
        "acquired",
        "selected",
        "admitted",
        "verified",
        "finalized",
        "quarantined"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "repository_id",
        "ownership",
        "git_head",
        "git_tree",
        "branch",
        "dirty",
        "untracked"
      ],
      "properties": {
        "kind": {"enum": ["git_url", "local_git", "local_directory"]},
        "locator": {"type": "string", "minLength": 1},
        "repository_id": {"type": ["string", "null"]},
        "ownership": {"enum": ["owned", "external", "unknown"]},
        "git_head": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            {"type": "null"}
          ]
        },
        "git_tree": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            {"type": "null"}
          ]
        },
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "untracked": {"type": "boolean"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "checkout",
        "remote_policy",
        "include_ignored",
        "lfs_policy",
        "submodule_policy",
        "original_remotes"
      ],
      "properties": {
        "mode": {"enum": ["clone", "copy"]},
        "checkout": {"const": "checkout"},
        "remote_policy": {"enum": ["sever", "fetch_only", "preserve"]},
        "include_ignored": {"type": "boolean"},
        "lfs_policy": {"enum": ["pointers", "fetch"]},
        "submodule_policy": {"enum": ["record", "fetch"]},
        "original_remotes": {
          "type": "array",
          "items": {"$ref": "#/$defs/remote"}
        }
      }
    },
    "inventory": {"const": "control/inventory.json"},
    "selections": {"const": "control/selections.json"},
    "admission": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "targets"],
          "properties": {
            "mode": {"enum": ["generated", "linked_existing", "git_migration"]},
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/target"}
            }
          }
        }
      ]
    },
    "verification": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified_at", "verified", "targets"],
          "properties": {
            "verified_at": {"type": "string", "format": "date-time"},
            "verified": {"const": true},
            "targets": {
              "type": "array",
              "items": {"$ref": "#/$defs/target"}
            }
          }
        }
      ]
    },
    "finalization": {"type": ["string", "null"]},
    "action_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "event", "details"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "event": {"type": "string", "minLength": 1},
          "details": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "name", "fetch_url", "push_url"],
      "properties": {
        "repository_path": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "fetch_url": {"type": "string", "minLength": 1},
        "push_url": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "intake_manifest",
            "candidate",
            "experiment_plan",
            "experiment_run",
            "readme_record",
            "migration_receipt",
            "other"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
