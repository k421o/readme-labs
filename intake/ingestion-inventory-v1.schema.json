{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/intake/ingestion-inventory-v1.schema.json",
  "title": "README Labs ingestion inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "observed_at",
    "file_count",
    "total_bytes",
    "symlinks",
    "ignored_files_policy",
    "git"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "symlinks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "ignored_files_policy": {"enum": ["excluded", "included"]},
    "git": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "tree",
            "branch",
            "staged",
            "modified",
            "untracked",
            "ignored",
            "submodules",
            "lfs",
            "remotes"
          ],
          "properties": {
            "head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            "branch": {"type": ["string", "null"]},
            "staged": {"type": "array", "items": {"type": "string"}},
            "modified": {"type": "array", "items": {"type": "string"}},
            "untracked": {"type": "array", "items": {"type": "string"}},
            "ignored": {"type": "array", "items": {"type": "string"}},
            "submodules": {"type": "array", "items": {"type": "string"}},
            "lfs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "tracked_paths"],
              "properties": {
                "available": {"type": "boolean"},
                "tracked_paths": {"type": "array", "items": {"type": "string"}}
              }
            },
            "remotes": {"type": "array", "items": {"type": "object"}}
          }
        }
      ]
    }
  }
}
