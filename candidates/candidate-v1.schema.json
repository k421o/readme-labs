{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k421o/readme-labs/blob/main/candidates/candidate-v1.schema.json",
  "title": "README Labs candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "authority",
    "storage",
    "source_bindings",
    "entrypoints",
    "hypotheses",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "skill",
        "skill_bundle",
        "plugin",
        "research_method",
        "evaluation_method",
        "workflow",
        "repository_solution",
        "other"
      ]
    },
    "authority": {"const": "experimental_candidate_only"},
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "artifact_root", "tree_sha256"],
          "properties": {
            "mode": {"const": "embedded"},
            "artifact_root": {"type": "string", "minLength": 1},
            "tree_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "locator", "revision", "tree_sha256"],
          "properties": {
            "mode": {"const": "external"},
            "locator": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "tree_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "item_ids"],
        "properties": {
          "manifest": {"type": "string", "minLength": 1},
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "format"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "host": {"type": ["string", "null"]}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
