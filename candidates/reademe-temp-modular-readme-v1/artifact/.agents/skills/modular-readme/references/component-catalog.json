{
  "schema_version": 1,
  "always_on": [
    "relative-links"
  ],
  "profiles": {
    "minimal": {
      "description": "The shortest useful reader path; add license when repository evidence supports it.",
      "components": ["project-title", "short-description", "usage-quickstart"]
    },
    "reusable-library": {
      "description": "A package or library with installation, usage, and a public API.",
      "components": ["project-title", "github-badges", "short-description", "key-features", "installation", "usage-quickstart", "api-reference", "contributing"]
    },
    "cli-tool": {
      "description": "A command-line project with setup, configuration, commands, and recovery guidance.",
      "components": ["project-title", "github-badges", "short-description", "prerequisites", "installation", "configuration", "usage-quickstart", "cli-reference", "troubleshooting"]
    },
    "application": {
      "description": "An end-user application whose value benefits from visual explanation.",
      "components": ["project-title", "banner-or-logo", "short-description", "key-features", "visual-demo", "installation", "configuration", "usage-quickstart", "security"]
    },
    "service-platform": {
      "description": "A service or platform with architecture, configuration, API, and governance context.",
      "components": ["project-title", "github-badges", "short-description", "architecture-overview", "prerequisites", "configuration", "usage-quickstart", "api-reference", "security", "contributing"]
    },
    "custom": {
      "description": "No preset components; every worker component is selected with --include.",
      "components": []
    }
  },
